# ====================================================
# CloudCart Platform - Environment Variables Template
# ====================================================

# AWS & LocalStack Settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Database (PostgreSQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudcart
DB_USER=cloudcart_user
DB_PASSWORD=cloudcart_password

# DynamoDB (Amazon DynamoDB / LocalStack)
DYNAMODB_ENDPOINT=http://localhost:4566
USERS_TABLE=cloudcart-users

# Messaging (Amazon SNS / Amazon SQS / LocalStack)
SNS_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566
ORDER_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:cloudcart-order-events
INVENTORY_QUEUE_URL=http://localhost:4566/000000000000/cloudcart-inventory-queue
NOTIFICATION_QUEUE_URL=http://localhost:4566/000000000000/cloudcart-notification-queue

# Service Ports
PRODUCT_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
INVENTORY_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005
FRONTEND_PORT=3000
